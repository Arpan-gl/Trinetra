# ==========================================
# Trinetra - Git Ignore Rules (SIH PS 26145)
# ==========================================

# 1. Dataset & Data Storage (Prevent uploading multi-gigabyte datasets)
data/
*.csv
*.parquet
*.pcap
*.pcapng
*.pcap.gz
*.zip
*.tar
*.gz
*.7z
*.rar

# 2. Machine Learning Model Weights & Checkpoints (exclude raw training checkpoints)
checkpoints/
artifacts/*.pkl
artifacts/*.pt
*.joblib
*.h5
*.pth
*.bin

# Allow versioned CLI model bundle (under 5 MB total)
!models/v0.1/
!models/v0.1/**

# 3. Python Cache & Environment
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
.venv/
env/
ENV/

# 4. Logs & Task Outputs
*.log
logs/

# 5. OS and IDE Artifacts
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# 6. Scratch & Temp Directories
scratch/
tmp/
temp/
node_modules/
